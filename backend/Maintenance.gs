/* Respaldo y monitor: instalar manualmente. Retención personal permanece desactivada. */
function maintenanceFolder_(){const id=config_('BACKUP_FOLDER_ID');need_(id,'Configurá BACKUP_FOLDER_ID con una carpeta privada.');const folder=DriveApp.getFolderById(id);need_(folder.getSharingAccess()===DriveApp.Access.PRIVATE&&folder.getEditors().length===0&&folder.getViewers().length===0,'La carpeta de respaldos debe ser privada y sin colaboradores.');return folder;}
function maintenanceDay_(){return Utilities.formatDate(new Date(),'America/Argentina/Buenos_Aires','yyyy-MM-dd');}
function maintenanceFiles_(folder,prefix){const iterator=folder.getFiles(),files=[];while(iterator.hasNext()){const f=iterator.next();if(f.getName().startsWith(prefix)&&f.getMimeType()===MimeType.GOOGLE_SHEETS)files.push(f)}return files.sort((a,b)=>b.getName().localeCompare(a.getName()));}
function backupDaily_(){
 const lock=LockService.getUserLock();if(!lock.tryLock(1000))return {busy:true};
 try{const folder=maintenanceFolder_(),day=maintenanceDay_(),name='DC-T4-DAILY-'+day,existing=folder.getFilesByName(name);let copy;
  if(existing.hasNext())copy=existing.next();else copy=DriveApp.getFileById(config_('SPREADSHEET_ID')).makeCopy(name,folder);
  if(new Date(day+'T12:00:00Z').getUTCDay()===0){const weekly='DC-T4-WEEKLY-'+day;if(!folder.getFilesByName(weekly).hasNext())copy.makeCopy(weekly,folder);}
  const removed=[];for(const [prefix,keep]of [['DC-T4-DAILY-',30],['DC-T4-WEEKLY-',12]])for(const file of maintenanceFiles_(folder,prefix).slice(keep)){file.setTrashed(true);removed.push(file.getName())}
  props_().setProperty('BACKUP_LAST_SUCCESS',now_());return {id:copy.getId(),name,removed};
 }catch(_){if(typeof securityNotify_==='function')securityNotify_('Falló el respaldo diario','Revisá la carpeta privada y la última copia correcta.');throw new Error('No se pudo completar el respaldo. No se eliminan copias fuera de la carpeta y prefijos administrados.');}finally{lock.releaseLock();}
}
function recoverySnapshotProperties_(){
 const all=props_().getProperties(),snapshot=Object.fromEntries(Object.entries(all).filter(([key])=>!key.startsWith('RECOVERY_T4_'))),text=JSON.stringify(snapshot),chars=Array.from(text),chunks=[];for(let i=0;i<chars.length;i+=2000)chunks.push(chars.slice(i,i+2000).join(''));
 need_(Utilities.newBlob(text).getBytes().length<180000,'La copia de propiedades supera el límite seguro.');const old=securityJson_('RECOVERY_T4_META',{count:0});chunks.forEach((chunk,i)=>props_().setProperty('RECOVERY_T4_'+i,chunk));for(let i=chunks.length;i<old.count;i++)props_().deleteProperty('RECOVERY_T4_'+i);props_().setProperty('RECOVERY_T4_META',JSON.stringify({count:chunks.length,hash:hash_(text),at:now_()}));return {saved:true,properties:Object.keys(snapshot).length};
}
function recoveryRestorePropertiesEnsayo_(){
 need_(config_('SECURITY_ENV')==='ensayo'&&config_('MAIL_MODE')==='disabled','Restauración automática permitida solo en ensayo sin correo.');const current=config_('SPREADSHEET_ID');need_(SpreadsheetApp.openById(current).getName().startsWith('ENSAYO '),'La hoja no es de ensayo.');const meta=securityJson_('RECOVERY_T4_META',null);need_(meta&&meta.count>0,'Falta una copia de propiedades.');let text='';for(let i=0;i<meta.count;i++)text+=config_('RECOVERY_T4_'+i);need_(hash_(text)===meta.hash,'El respaldo de propiedades no coincide.');const saved=JSON.parse(text);need_(saved.SECURITY_ENV==='ensayo'&&saved.MAIL_MODE==='disabled'&&saved.SPREADSHEET_ID===current,'El respaldo no corresponde a este ensayo.');
 for(const key of Object.keys(props_().getProperties()))if(!key.startsWith('RECOVERY_T4_'))props_().deleteProperty(key);props_().setProperties(saved);return {restored:true,properties:Object.keys(saved).length};
}
function monitorEvery15Minutes_(){
 const failures=[];const site=config_('SITE_URL'),api=config_('MONITOR_EXEC_URL');need_(/^https:\/\/[a-z0-9.-]+\/?$/i.test(site)&&/^https:\/\/script\.google\.com\/macros\/s\/[A-Za-z0-9_-]+\/exec$/.test(api),'Configurá las URLs del monitor.');
 try{const r=UrlFetchApp.fetch(site,{muteHttpExceptions:true});if(r.getResponseCode()!==200||!r.getContentText().includes('Disfraz Cabezón'))failures.push('web')}catch(_){failures.push('web')}
 try{const r=UrlFetchApp.fetch(api,{method:'post',contentType:'application/json',payload:JSON.stringify({action:'catalogData'}),muteHttpExceptions:true});let j;try{j=JSON.parse(r.getContentText())}catch(_){}if(r.getResponseCode()!==200||j?.ok!==true||!Array.isArray(j.data?.products)||!j.data.products.length)failures.push('catálogo')}catch(_){failures.push('catálogo')}
 const lock=LockService.getScriptLock();need_(lock.tryLock(1000),'El monitor no pudo guardar el estado.');try{const state=securityJson_('MONITOR_STATE',{consecutive:0,alerted:false});if(failures.length){state.consecutive++;if(state.consecutive>=2&&!state.alerted){state.alerted=true;securityNotify_('Sitio o catálogo sin respuesta','Dos comprobaciones consecutivas fallaron: '+failures.join(', '));}}else{if(state.alerted)securityNotify_('Sitio recuperado','La web y el catálogo vuelven a responder.');state.consecutive=0;state.alerted=false;}state.checkedAt=now_();state.failures=failures;props_().setProperty('MONITOR_STATE',JSON.stringify(state));return {ok:!failures.length,consecutive:state.consecutive,alerted:state.alerted};}finally{lock.releaseLock();}
}
function prepararMantenimientoTanda4_(){
 maintenanceFolder_();need_(config_('MONITOR_EXEC_URL'),'Configurá MONITOR_EXEC_URL.');const triggers=ScriptApp.getProjectTriggers();if(!triggers.some(t=>t.getHandlerFunction()==='backupDaily_'))ScriptApp.newTrigger('backupDaily_').timeBased().atHour(2).nearMinute(30).everyDays(1).inTimezone('America/Argentina/Buenos_Aires').create();if(!triggers.some(t=>t.getHandlerFunction()==='monitorEvery15Minutes_'))ScriptApp.newTrigger('monitorEvery15Minutes_').timeBased().everyMinutes(15).create();return {backup:'02:30 Argentina',monitorMinutes:15,personalRetention:'NOT_INSTALLED'};
}
function retentionCandidates_(requests,now=Date.now()){
 const dniDays=Number(config_('PERSONAL_DNI_RETENTION_DAYS')),receiptDays=Number(config_('PERSONAL_RECEIPT_RETENTION_DAYS'));const candidates=[];
 for(const row of requests){const closed=Date.parse(row.closedAt);if(!['returned','refunded','rejected'].includes(row.status)||row.legalHold||row.retentionHold||!Number.isFinite(closed)||closed>now)continue;const age=(now-closed)/86400000;for(const group of ['files','signedFiles','managementFiles'])for(const [slot,file]of Object.entries(row[group]||{})){const days=slot==='receipt'?receiptDays:['dniFront','dniBack','addressProof'].includes(slot)?dniDays:0;if(days>=1&&age>=days&&file?.id&&!file.removedAt)candidates.push({rowId:row.id,group,slot,id:file.id});}}
 const deletable=new Set(candidates.map(c=>c.id));for(const row of requests)for(const group of ['files','signedFiles','managementFiles'])for(const [slot,file]of Object.entries(row[group]||{}))if(file?.id&&!candidates.some(c=>c.rowId===row.id&&c.group===group&&c.slot===slot))deletable.delete(file.id);
 return candidates.filter(c=>deletable.has(c.id));
}
function cleanupPersonalFiles_(){
 const rows=rows_('reservas'),candidates=retentionCandidates_(rows);if(config_('PERSONAL_RETENTION_APPROVED')!=='yes')return {dryRun:true,files:[...new Set(candidates.map(c=>c.id))].length,records:[...new Set(candidates.map(c=>c.rowId))].length};
 need_(Number(config_('PERSONAL_DNI_RETENTION_DAYS'))>=1&&Number(config_('PERSONAL_RECEIPT_RETENTION_DAYS'))>=1,'Falta aprobar ambos plazos.');
 return lock_(()=>{const fresh=rows_('reservas'),safe=retentionCandidates_(fresh),ids=[...new Set(safe.map(c=>c.id))].slice(0,30);let trashed=0;for(const id of ids){try{DriveApp.getFileById(id).setTrashed(true)}catch(_){continue}trashed++;for(const entry of safe.filter(c=>c.id===id)){const row=fresh.find(r=>r.id===entry.rowId),file=row[entry.group][entry.slot];const {id:removedId,...metadata}=file;row[entry.group][entry.slot]={...metadata,removedAt:now_(),reason:'approved-retention'};row.events=row.events||[];row.events.push({action:'document_retention',note:'Documento enviado a la papelera según el plazo aprobado.',at:now_()});put_('reservas',row);}}return {dryRun:false,trashed};});
}
function prepararRetencionAprobada_(){need_(config_('PERSONAL_RETENTION_APPROVED')==='yes'&&Number(config_('PERSONAL_DNI_RETENTION_DAYS'))>=1&&Number(config_('PERSONAL_RECEIPT_RETENTION_DAYS'))>=1,'El dueño debe aprobar los plazos antes de instalar.');if(!ScriptApp.getProjectTriggers().some(t=>t.getHandlerFunction()==='cleanupPersonalFiles_'))ScriptApp.newTrigger('cleanupPersonalFiles_').timeBased().atHour(4).everyDays(1).inTimezone('America/Argentina/Buenos_Aires').create();return {ready:true};}
function inventoryPropertyNames_(){return Object.keys(props_().getProperties()).filter(k=>!k.startsWith('RECOVERY_T4_')).sort();}
